razor Iepan_Flaviu_Lab2\Views\Books\Details.cshtml
@model Iepan_Flaviu_Lab2.Models.Book

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Book</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Title)</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-10">@Model.Price</dd>

        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@((Model.AuthorRef != null) ? Model.AuthorRef.FirstName + " " + Model.AuthorRef.LastName : "(no author)")</dd>

        <dt class="col-sm-2">Genre</dt>
        <dd class="col-sm-10">@Model.Genre?.Name</dd>
    </dl>

<hr />

</div>
<h4>Orders</h4>
@if (Model.Orders != null && Model.Orders.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Order date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Orders)
            {
                <tr>
                    <td>@order.OrderID</td>
                    <td>@(order.Customer != null ? order.Customer.Name : "(no customer)")</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p><em>No orders for this book.</em></p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>