@model Iepan_Flaviu_Lab2.Models.Author

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Author</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">First name:</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FirstName)</dd>

        <dt class="col-sm-2">Last name:</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.LastName)</dd>
    </dl>
</div>

<hr />

<h4>Books by this author</h4>

@if (Model.Books != null && Model.Books.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Genre</th>
                <th>Price</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@(book.Genre?.Name ?? "(no genre)")</td>
                    <td>@book.Price</td>
                    <td>
                        <a asp-controller="Books" asp-action="Details" asp-route-id="@book.ID">Details</a> |
                        <a asp-controller="Books" asp-action="Edit" asp-route-id="@book.ID">Edit</a> |
                        <a asp-controller="Books" asp-action="Delete" asp-route-id="@book.ID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p><em>No books found for this author.</em></p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model?.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>